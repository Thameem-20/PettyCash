# Copy this file to .env.local and fill in your values

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pettycash

# Auth secret used to sign JWT session cookies (use a long random string)
JWT_SECRET=change_me_to_a_long_random_secret_string

# Where uploaded receipt files are stored on disk (relative to project root)
UPLOAD_DIR=uploads
