# Copy this file to .env.local and fill in your values

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pettycash

# Auth secret used to sign JWT session cookies (use a long random string)
JWT_SECRET=change_me_to_a_long_random_secret_string

# Local disk uploads (used when Azure is not configured)
UPLOAD_DIR=uploads

# Azure Blob Storage (optional — when set, new uploads go to Blob)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=pettycashreciepts

# Web Push (optional — Settings → Enable notifications)
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourcompany.com

# Force maintenance mode regardless of admin toggle (1/true/on or 0/false/off)
# MAINTENANCE_MODE=0
